generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ClientRole {
  OWNER
  MANAGER
  MEMBER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  WAITING_ON_CLIENT
  ON_HOLD
  COMPLETED
  CANCELLED
}


model Client {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  memberships ClientMembership[]
  projects Project[]

  @@map("clients")
}

model User {
  id           String       @id @default(cuid())
  clerkUserId  String       @unique @map("clerk_user_id")
  email        String       @unique
  firstName    String?      @map("first_name")
  lastName     String?      @map("last_name")
  platformRole PlatformRole @default(USER) @map("platform_role")
  isActive     Boolean      @default(true) @map("is_active")
  memberships ClientMembership[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model ClientMembership {
  clientId String     @map("client_id")
  userId   String     @map("user_id")
  role     ClientRole @default(MEMBER)
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([clientId, userId])
  @@index([userId])
  @@map("client_memberships")
}

model Project {
  id                String        @id @default(cuid())
  clientId          String        @map("client_id")
  name              String
  description       String?
  status            ProjectStatus @default(PLANNING)
  startDate         DateTime?     @map("start_date")
  targetEndDate     DateTime?     @map("target_end_date")
  completedAt       DateTime?     @map("completed_at")
  isVisibleToClient Boolean       @default(true) @map("is_visible_to_client")
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([clientId, isVisibleToClient])
  @@index([clientId, status])
  @@map("projects")
}
