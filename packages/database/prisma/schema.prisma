generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}



model Client {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("clients")
}

